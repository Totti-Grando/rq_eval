# rq_eval secrets template. Copy to `.env` and fill in on the target machine.
# `.env` is git-ignored and never committed. Only config.py reads this file
# (into os.environ, without overwriting existing vars); boto3 consumes it in
# live mode. In mock mode none of these are needed.

# Option 1 — named AWS profile (recommended; also set aws.profile in config.yaml)
AWS_PROFILE=default

# Option 2 — explicit keys (leave blank if using a profile / SSO)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Region can also be set here; config.yaml aws.region takes precedence in code.
AWS_DEFAULT_REGION=us-east-1
